DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DB_NAME=spotter
DB_USER=spotter
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=55432
ROUTING_PROVIDER_API_KEY=replace-with-a-provider-key
ROUTING_CONNECT_TIMEOUT_SECONDS=3
ROUTING_READ_TIMEOUT_SECONDS=15
ROUTING_TOTAL_DEADLINE_SECONDS=30
ROUTE_CACHE_TIMEOUT_SECONDS=3600
PLAN_CACHE_TIMEOUT_SECONDS=1800
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=spotter-local
STATION_CORRIDOR_MILES=5
STATION_SNAP_TOLERANCE_MILES=0.5
GEOCODING_OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter
USA_BOUNDARY_PATH=artifacts/us-states-2024.geojson.gz
PLAN_LOG_LEVEL=INFO
